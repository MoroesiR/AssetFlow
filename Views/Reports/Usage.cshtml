@model AssetFlow.Models.UsageReportViewModel

@{
    ViewData["Title"] = "Equipment Usage";
    var sort = ViewBag.Sort as string ?? "used";
    var never = Model.Rows.Count(r => r.NeverUsed);
    var idle = Model.Rows.Where(r => !r.CurrentlyOut && r.IdleDays >= 30).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0">Equipment Usage</h1>
        <p class="text-muted mb-0">What actually gets used, and what sits there</p>
    </div>
    <a asp-action="Trends" class="btn btn-outline-primary btn-sm">
        <i class="fas fa-chart-line me-1"></i>Trends over time
    </a>
</div>

@if (Model.TotalEpisodes == 0)
{
    <div class="alert alert-warning">
        <i class="fas fa-circle-info me-1"></i>
        There are no checkouts on record yet, so there is nothing to measure. The
        figures fill in as equipment is checked out and returned.
    </div>
}
else if (Model.HistoryIsShallow)
{
    <div class="alert alert-info">
        <i class="fas fa-circle-info me-1"></i>
        <strong>Read these numbers carefully.</strong>
        @if (Model.ObservedFrom.HasValue)
        {
            <span>
                This system has only been recording checkouts for
                @Model.DaysObserved day(s), since @Model.ObservedFrom.Value.ToString("dd MMM yyyy").
            </span>
        }
        else
        {
            <span>This system has not yet observed a full checkout of its own.</span>
        }
        @if (Model.BackfilledEpisodes > 0)
        {
            <span>
                @Model.BackfilledEpisodes of the @Model.TotalEpisodes episode(s) were
                carried over from what was already signed out, so their start dates are
                older than the record itself.
            </span>
        }
        <span>
            Anything returned before then was never kept, so "never checked out" means
            "not since we started counting" - not that the item has never been used.
        </span>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Assets tracked</div>
                <div class="h3 mb-0">@Model.Rows.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Checkout episodes</div>
                <div class="h3 mb-0">@Model.TotalEpisodes</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Never checked out</div>
                <div class="h3 mb-0 @(never > 0 ? "text-warning" : "")">@never</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Idle 30+ days</div>
                <div class="h3 mb-0 @(idle.Count > 0 ? "text-danger" : "")">@idle.Count</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
        <small class="text-muted me-2">Order by:</small>
        <a asp-action="Usage" asp-route-sort="used" class="btn btn-sm @(sort == "used" ? "btn-primary" : "btn-outline-secondary")">Most used</a>
        <a asp-action="Usage" asp-route-sort="least" class="btn btn-sm @(sort == "least" ? "btn-primary" : "btn-outline-secondary")">Least used</a>
        <a asp-action="Usage" asp-route-sort="idle" class="btn btn-sm @(sort == "idle" ? "btn-primary" : "btn-outline-secondary")">Longest idle</a>
        <a asp-action="Usage" asp-route-sort="utilisation" class="btn btn-sm @(sort == "utilisation" ? "btn-primary" : "btn-outline-secondary")">Utilisation</a>
        <a asp-action="Usage" asp-route-sort="value" class="btn btn-sm @(sort == "value" ? "btn-primary" : "btn-outline-secondary")">Value</a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Asset</th>
                    <th class="text-end">Times out</th>
                    <th class="text-end d-none d-md-table-cell">Days out</th>
                    <th style="min-width: 150px;">Utilisation</th>
                    <th class="text-end">Idle</th>
                    <th class="d-none d-lg-table-cell">Last activity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>
                            <div class="fw-medium">@row.Name</div>
                            <small class="text-muted">
                                <code>@row.SerialNumber</code> · @row.Category
                            </small>
                        </td>
                        <td class="text-end">
                            @if (row.NeverUsed)
                            {
                                <span class="badge bg-warning text-dark">never</span>
                            }
                            else
                            {
                                <span class="fw-medium">@row.TimesCheckedOut</span>
                            }
                        </td>
                        <td class="text-end d-none d-md-table-cell">@row.DaysOut</td>
                        <td>
                            @{
                                var pct = row.UtilisationPercent;
                                var bar = pct > 100 ? 100 : pct;
                                var tone = pct >= 50 ? "bg-success" : pct >= 15 ? "bg-info" : "bg-secondary";
                            }
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 6px; min-width: 60px;">
                                    <div class="progress-bar @tone" style="width: @bar.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <small class="text-muted text-nowrap">@pct%</small>
                            </div>
                        </td>
                        <td class="text-end">
                            @if (row.CurrentlyOut)
                            {
                                <span class="badge bg-primary">out now</span>
                            }
                            else if (row.IdleDays >= 90)
                            {
                                <span class="badge bg-danger">@row.IdleDays d</span>
                            }
                            else if (row.IdleDays >= 30)
                            {
                                <span class="badge bg-warning text-dark">@row.IdleDays d</span>
                            }
                            else
                            {
                                <span class="text-muted">@row.IdleDays d</span>
                            }
                        </td>
                        <td class="d-none d-lg-table-cell">
                            <small class="text-muted">
                                @if (row.LastReturned.HasValue)
                                {
                                    <span>back @row.LastReturned.Value.ToString("dd MMM yy")</span>
                                }
                                else if (row.LastCheckedOut.HasValue)
                                {
                                    <span>out @row.LastCheckedOut.Value.ToString("dd MMM yy")</span>
                                }
                                else
                                {
                                    <span>no activity</span>
                                }
                            </small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<p class="text-muted small mt-3">
    Utilisation is the share of the tracked window an asset has spent in somebody's
    hands, measured from the earlier of its purchase date and its first recorded
    checkout. Idle is days since it last came back.
</p>
