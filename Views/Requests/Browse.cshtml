@model IEnumerable<AssetFlow.Models.Asset>

@{
    ViewData["Title"] = "Browse Equipment";
    var alreadyRequested = ViewBag.AlreadyRequested as List<int> ?? new List<int>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Available Equipment</h1>
        <p class="text-muted mb-0">@Model.Count() item(s) you can request right now</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-paper-plane me-1"></i>My Requests
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle me-1"></i>@TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle me-1"></i>@TempData["ErrorMessage"]
    </div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="Browse" class="row g-2 align-items-center">
            <div class="col-auto">
                <small class="text-muted">Filter by:</small>
            </div>
            <div class="col-auto">
                <select name="category" class="form-select form-select-sm" style="width: 170px;">
                    <option value="">All Categories</option>
                    <option value="IT Equipment" selected="@(ViewBag.SelectedCategory == "IT Equipment")">IT Equipment</option>
                    <option value="Furniture" selected="@(ViewBag.SelectedCategory == "Furniture")">Furniture</option>
                    <option value="AV Equipment" selected="@(ViewBag.SelectedCategory == "AV Equipment")">AV Equipment</option>
                    <option value="Office Supplies" selected="@(ViewBag.SelectedCategory == "Office Supplies")">Office Supplies</option>
                </select>
            </div>
            <div class="col-auto ms-auto">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <input type="text" name="search" class="form-control" placeholder="Search equipment..."
                           value="@ViewBag.SearchTerm">
                    <button class="btn btn-outline-secondary" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || !string.IsNullOrEmpty(ViewBag.SelectedCategory))
                    {
                        <a asp-action="Browse" class="btn btn-outline-danger">
                            <i class="fas fa-times"></i>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="row">
        @foreach (var asset in Model)
        {
            var pending = alreadyRequested.Contains(asset.Id);

            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center mb-2">
                            <div class="me-3">
                                @if (asset.Category == "IT Equipment")
                                {
                                    <i class="fas fa-laptop fa-2x text-primary"></i>
                                }
                                else if (asset.Category == "Furniture")
                                {
                                    <i class="fas fa-chair fa-2x text-success"></i>
                                }
                                else if (asset.Category == "AV Equipment")
                                {
                                    <i class="fas fa-tv fa-2x text-warning"></i>
                                }
                                else
                                {
                                    <i class="fas fa-box fa-2x text-secondary"></i>
                                }
                            </div>
                            <div>
                                <h6 class="mb-1">@asset.Name</h6>
                                <span class="badge bg-light text-dark">@asset.Category</span>
                            </div>
                        </div>

                        <div class="small text-muted mb-3">
                            <div><i class="fas fa-barcode me-1"></i>@asset.SerialNumber</div>
                            @if (!string.IsNullOrEmpty(asset.Location))
                            {
                                <div><i class="fas fa-map-marker-alt me-1"></i>@asset.Location</div>
                            }
                        </div>

                        <div class="mt-auto">
                            @if (pending)
                            {
                                <button class="btn btn-outline-secondary btn-sm w-100" disabled>
                                    <i class="fas fa-hourglass-half me-1"></i>Request Pending
                                </button>
                            }
                            else
                            {
                                <a asp-action="Create" asp-route-id="@asset.Id" class="btn btn-primary btn-sm w-100">
                                    <i class="fas fa-paper-plane me-1"></i>Request This
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
        <h4 class="text-muted">Nothing available</h4>
        <p class="text-muted">
            Everything matching your filter is either checked out or in for maintenance.
            Try again later or check with the IT department.
        </p>
        <a asp-action="Browse" class="btn btn-outline-primary">Clear filters</a>
    </div>
}
