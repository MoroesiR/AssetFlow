@model IEnumerable<AssetFlow.Models.Asset>

@{
    ViewData["Title"] = "Assets Inventory";
}

@* Wraps instead of squashing once the three buttons stop fitting beside the heading. *@
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0">Assets Inventory</h1>
        <p class="text-muted mb-0">
            Showing @Model.Count() of @ViewBag.TotalAssets assets registered
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-primary btn-sm-block">
            <i class="fas fa-plus me-1"></i>Add Asset
        </a>
        <a asp-action="Import" class="btn btn-outline-primary btn-sm-block">
            <i class="fas fa-file-import me-1"></i>Import CSV
        </a>
        <button class="btn btn-outline-secondary btn-sm-block d-none d-sm-inline-block" onclick="window.print()">
            <i class="fas fa-print me-1"></i>Print
        </button>
    </div>
</div>


@{
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var vendors = ViewBag.Vendors as List<string> ?? new List<string>();
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    var flag = ViewBag.SelectedFlag as string;

    var anyFilter = !string.IsNullOrEmpty(ViewBag.SearchTerm as string)
        || !string.IsNullOrEmpty(ViewBag.SelectedStatus as string)
        || !string.IsNullOrEmpty(ViewBag.SelectedCategory as string)
        || !string.IsNullOrEmpty(ViewBag.SelectedVendor as string)
        || !string.IsNullOrEmpty(ViewBag.SelectedDepartment as string)
        || ViewBag.MinPrice != null
        || ViewBag.MaxPrice != null
        || !string.IsNullOrEmpty(flag);
}

<div class="card mb-3">
    @* Ten fields is a long scroll before you reach the table on a phone, so below md
       the panel folds away behind a button. Above md it is always open and the
       toggle is not rendered at all. *@
    <div class="card-header d-md-none py-2">
        <button class="btn btn-sm btn-outline-secondary w-100" type="button"
                data-bs-toggle="collapse" data-bs-target="#filterPanel"
                aria-expanded="@(anyFilter ? "true" : "false")" aria-controls="filterPanel">
            <i class="fas fa-sliders-h me-1"></i>Search and filters
            @if (anyFilter)
            {
                <span class="badge bg-primary ms-1">on</span>
            }
        </button>
    </div>
    <div class="collapse d-md-block @(anyFilter ? "show" : "")" id="filterPanel">
    <div class="card-body py-3">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Search</label>
                    <input type="text" name="search" class="form-control form-control-sm"
                           placeholder="Name, serial, location, vendor, holder"
                           value="@ViewBag.SearchTerm">
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Status</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">All</option>
                        <option value="Available" selected="@(ViewBag.SelectedStatus == "Available")">Available</option>
                        <option value="CheckedOut" selected="@(ViewBag.SelectedStatus == "CheckedOut")">Checked Out</option>
                        <option value="Maintenance" selected="@(ViewBag.SelectedStatus == "Maintenance")">Maintenance</option>
                        <option value="Retired" selected="@(ViewBag.SelectedStatus == "Retired")">Retired</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Category</label>
                    <select name="category" class="form-select form-select-sm">
                        <option value="">All</option>
                        @foreach (var item in categories)
                        {
                            <option value="@item" selected="@(ViewBag.SelectedCategory as string == item)">@item</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Vendor</label>
                    <select name="vendor" class="form-select form-select-sm">
                        <option value="">All</option>
                        @foreach (var item in vendors)
                        {
                            <option value="@item" selected="@(ViewBag.SelectedVendor as string == item)">@item</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Sort by</label>
                    <select name="sort" class="form-select form-select-sm">
                        <option value="">Name (A-Z)</option>
                        <option value="name_desc" selected="@(ViewBag.SelectedSort == "name_desc")">Name (Z-A)</option>
                        <option value="price_desc" selected="@(ViewBag.SelectedSort == "price_desc")">Price (high first)</option>
                        <option value="price" selected="@(ViewBag.SelectedSort == "price")">Price (low first)</option>
                        <option value="purchased_desc" selected="@(ViewBag.SelectedSort == "purchased_desc")">Newest purchase</option>
                        <option value="purchased" selected="@(ViewBag.SelectedSort == "purchased")">Oldest purchase</option>
                        <option value="status" selected="@(ViewBag.SelectedSort == "status")">Status</option>
                    </select>
                </div>
            </div>

            <div class="row g-2 align-items-end mt-1">
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Held by dept</label>
                    <select name="department" class="form-select form-select-sm">
                        <option value="">Any</option>
                        @foreach (var item in departments)
                        {
                            <option value="@item" selected="@(ViewBag.SelectedDepartment as string == item)">@item</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Price from</label>
                    <input type="number" step="0.01" min="0" name="minPrice" class="form-control form-control-sm"
                           value="@ViewBag.MinPrice">
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Price to</label>
                    <input type="number" step="0.01" min="0" name="maxPrice" class="form-control form-control-sm"
                           value="@ViewBag.MaxPrice">
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Only show</label>
                    <select name="flag" class="form-select form-select-sm">
                        <option value="">Everything</option>
                        <option value="Overdue" selected="@(flag == "Overdue")">Overdue</option>
                        <option value="MaintenanceDue" selected="@(flag == "MaintenanceDue")">Maintenance due</option>
                        <option value="WarrantyExpired" selected="@(flag == "WarrantyExpired")">Warranty expired</option>
                        <option value="NoLocation" selected="@(flag == "NoLocation")">No location set</option>
                    </select>
                </div>
                <div class="col-md-3 text-md-end d-grid d-md-block gap-2">
                    <button class="btn btn-primary btn-sm" type="submit">
                        <i class="fas fa-search me-1"></i>Apply
                    </button>
                    @if (anyFilter)
                    {
                        <a asp-action="Index" class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-times me-1"></i>Clear
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
    </div>
</div>

@if (anyFilter && !Model.Any())
{
    <div class="alert alert-warning">
        <i class="fas fa-filter me-1"></i>
        Nothing matches those filters. <a asp-action="Index" class="alert-link">Clear them</a> to see everything.
    </div>
}


<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        @* Asset, status and the buttons are the three that survive on a
                           phone. The rest drop out by width rather than forcing a
                           sideways scroll to reach the actions. *@
                        <th style="width: 30%">Asset</th>
                        <th class="d-none d-lg-table-cell">Serial</th>
                        <th class="d-none d-xl-table-cell">Category</th>
                        <th>Status</th>
                        <th class="d-none d-md-table-cell">Value</th>
                        <th class="d-none d-xl-table-cell">Last Updated</th>
                        <th class="text-end" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        @if (item.Category == "IT Equipment")
                                        {
                                            <i class="fas fa-laptop text-primary"></i>
                                        }
                                        else if (item.Category == "Furniture")
                                        {
                                            <i class="fas fa-chair text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-box text-secondary"></i>
                                        }
                                    </div>
                                    <div>
                                        <div class="fw-medium">@item.Name</div>
                                        <small class="text-muted">@item.Location</small>
                                        @* The serial column is gone below lg, so it rides
                                           along here rather than being unreachable. *@
                                        <div class="d-lg-none">
                                            <code class="text-muted small">@item.SerialNumber</code>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="d-none d-lg-table-cell">
                                <code class="text-muted">@item.SerialNumber</code>
                            </td>
                            <td class="d-none d-xl-table-cell">
                                <span class="badge bg-light text-dark">@item.Category</span>
                            </td>
                            <td>
                                @{
                                    var statusClass = item.Status switch
                                    {
                                        "Available" => "badge bg-success",
                                        "CheckedOut" => "badge bg-warning",
                                        "Maintenance" => "badge bg-danger",
                                        _ => "badge bg-secondary"
                                    };
                                }
                                <span class="@statusClass">@item.Status</span>
                            </td>
                            <td class="fw-medium d-none d-md-table-cell">@item.PurchasePrice.ToString("C")</td>
                            <td class="d-none d-xl-table-cell">
                                <small class="text-muted">@item.LastUpdated.ToString("dd MMM yy")</small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-boxes fa-3x text-muted mb-3"></i>
        <h4 class="text-muted">No assets found</h4>
        <p class="text-muted">Get started by adding your first asset to the inventory.</p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Add First Asset
        </a>
    </div>
}


<div class="mt-3 text-muted small">
    <div class="d-flex justify-content-between">
        <div>
            <i class="fas fa-info-circle me-1"></i>
            Showing @Model.Count() assets •
            Total Value: @Model.Sum(a => a.PurchasePrice).ToString("C")
        </div>
        <div>
            <i class="fas fa-database me-1"></i>
            System ID: INV-@DateTime.Now.ToString("yyyyMMdd")
        </div>
    </div>
</div>