@model AssetFlow.Models.AssetRequest

@{
    ViewData["Title"] = "Request Details";
    var competing = (int)(ViewBag.CompetingRequests ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Request #@Model.Id</h1>
        <p class="text-muted mb-0">Submitted @Model.RequestedOn.ToString("dd MMM yyyy 'at' HH:mm")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Queue
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle me-1"></i>@TempData["ErrorMessage"]
    </div>
}

@if (competing > 0 && Model.Status == "Pending")
{
    <div class="alert alert-warning">
        <i class="fas fa-users me-1"></i>
        @competing other employee(s) have asked for this same asset. Approving this one
        leaves the rest with nothing to collect.
    </div>
}

<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-user me-2"></i>Requester
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-4 text-muted">Name</dt>
                    <dd class="col-8">@Model.RequesterName</dd>

                    <dt class="col-4 text-muted">Department</dt>
                    <dd class="col-8">@Model.RequesterDepartment</dd>

                    <dt class="col-4 text-muted">Email</dt>
                    <dd class="col-8">@Model.RequesterEmail</dd>

                    <dt class="col-4 text-muted">Needed From</dt>
                    <dd class="col-8">@Model.NeededFrom.ToString("dd MMM yyyy")</dd>

                    <dt class="col-4 text-muted">Return By</dt>
                    <dd class="col-8">@Model.NeededUntil.ToString("dd MMM yyyy") <span class="text-muted">(@Model.DaysRequested days)</span></dd>

                    <dt class="col-4 text-muted">Reason</dt>
                    <dd class="col-8">@Model.Reason</dd>
                </dl>
            </div>
        </div>

        @if (Model.Status == "Pending")
        {
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-gavel me-2"></i>Decision
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 mb-4">
                        <a asp-action="Approve" asp-route-id="@Model.Id" class="btn btn-success">
                            <i class="fas fa-check me-1"></i>Approve and Check Out
                        </a>
                    </div>

                    <hr />

                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Reject this request?');">
                        <div class="mb-3">
                            <label for="reviewNotes" class="form-label">Reason for rejection</label>
                            <textarea id="reviewNotes" name="reviewNotes" class="form-control" rows="3"
                                      placeholder="e.g. Laptop is reserved for the new starter next week" required></textarea>
                            <div class="form-text">The requester sees this note on their request list.</div>
                        </div>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-times me-1"></i>Reject Request
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-history me-2"></i>Outcome
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-4 text-muted">Decision</dt>
                        <dd class="col-8">
                            @{
                                var statusClass = Model.Status switch
                                {
                                    "Approved" => "badge bg-success",
                                    "Rejected" => "badge bg-danger",
                                    _ => "badge bg-secondary"
                                };
                            }
                            <span class="@statusClass">@Model.Status</span>
                        </dd>

                        <dt class="col-4 text-muted">Reviewed By</dt>
                        <dd class="col-8">@(Model.ReviewedBy ?? "-")</dd>

                        <dt class="col-4 text-muted">Reviewed On</dt>
                        <dd class="col-8">@(Model.ReviewedOn?.ToString("dd MMM yyyy HH:mm") ?? "-")</dd>

                        <dt class="col-4 text-muted">Notes</dt>
                        <dd class="col-8">@(string.IsNullOrEmpty(Model.ReviewNotes) ? "-" : Model.ReviewNotes)</dd>
                    </dl>
                </div>
            </div>
        }
    </div>

    <div class="col-md-5">
        @if (Model.Asset != null)
        {
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-box me-2"></i>Asset
                </div>
                <div class="card-body">
                    <h5 class="mb-1">@Model.Asset.Name</h5>
                    <span class="badge bg-light text-dark mb-3">@Model.Asset.Category</span>

                    <dl class="row small mb-3">
                        <dt class="col-5 text-muted">Serial</dt>
                        <dd class="col-7"><code>@Model.Asset.SerialNumber</code></dd>

                        <dt class="col-5 text-muted">Status</dt>
                        <dd class="col-7">
                            @{
                                var assetClass = Model.Asset.Status switch
                                {
                                    "Available" => "badge bg-success",
                                    "CheckedOut" => "badge bg-warning",
                                    "Maintenance" => "badge bg-danger",
                                    _ => "badge bg-secondary"
                                };
                            }
                            <span class="@assetClass">@Model.Asset.Status</span>
                        </dd>

                        <dt class="col-5 text-muted">Location</dt>
                        <dd class="col-7">@(string.IsNullOrEmpty(Model.Asset.Location) ? "Not recorded" : Model.Asset.Location)</dd>

                        @if (Model.Asset.Status == "CheckedOut")
                        {
                            <dt class="col-5 text-muted">Held By</dt>
                            <dd class="col-7">@Model.Asset.CheckedOutToEmployee</dd>

                            <dt class="col-5 text-muted">Due Back</dt>
                            <dd class="col-7">@Model.Asset.ExpectedReturnDate?.ToString("dd MMM yyyy")</dd>
                        }
                    </dl>

                    <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.Asset.Id"
                       class="btn btn-outline-primary btn-sm w-100">
                        <i class="fas fa-eye me-1"></i>Open Asset Record
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-secondary">
                The asset attached to this request no longer exists in the inventory.
            </div>
        }
    </div>
</div>
