@model IEnumerable<AssetFlow.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    var unread = (int)ViewBag.UnreadCount;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Notifications</h1>
        <p class="text-muted mb-0">
            @if (unread > 0)
            {
                <span>@unread unread</span>
            }
            else
            {
                <span>You are all caught up</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm" @(unread == 0 ? "disabled" : "")>
                <i class="fas fa-check-double me-1"></i>Mark all read
            </button>
        </form>
        <form asp-action="ClearRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-broom me-1"></i>Clear read
            </button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle me-1"></i>@TempData["SuccessMessage"]
    </div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex gap-2 align-items-center">
            <small class="text-muted me-2">Show:</small>
            <a asp-action="Index" class="btn btn-sm @(ViewBag.Filter == "All" ? "btn-primary" : "btn-outline-secondary")">All</a>
            <a asp-action="Index" asp-route-filter="Unread" class="btn btn-sm @(ViewBag.Filter == "Unread" ? "btn-primary" : "btn-outline-secondary")">Unread</a>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="list-group list-group-flush">
            @foreach (var note in Model)
            {
                var icon = note.Category switch
                {
                    "Decision" => "fa-clipboard-check",
                    "Overdue" => "fa-clock",
                    "Maintenance" => "fa-screwdriver-wrench",
                    _ => "fa-inbox"
                };

                var tone = note.Category switch
                {
                    "Decision" => "text-success",
                    "Overdue" => "text-danger",
                    "Maintenance" => "text-warning",
                    _ => "text-primary"
                };

                <a asp-action="Open" asp-route-id="@note.Id"
                   class="list-group-item list-group-item-action @(note.IsRead ? "" : "bg-light")">
                    <div class="d-flex gap-3">
                        <div class="pt-1">
                            <i class="fas @icon @tone fa-lg"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="mb-1 @(note.IsRead ? "" : "fw-bold")">
                                    @note.Title
                                    @if (!note.IsRead)
                                    {
                                        <span class="badge bg-primary ms-1">New</span>
                                    }
                                </h6>
                                <small class="text-muted text-nowrap ms-2">@note.Age</small>
                            </div>
                            <p class="mb-0 small text-muted">@note.Message</p>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-bell-slash fa-2x text-muted mb-3"></i>
            <h5>Nothing here</h5>
            <p class="text-muted mb-0">
                @if (ViewBag.Filter == "Unread")
                {
                    <span>You have read everything. Switch to All to see the history.</span>
                }
                else
                {
                    <span>Requests, decisions and overdue equipment will show up here.</span>
                }
            </p>
        </div>
    </div>
}
